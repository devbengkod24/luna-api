# Application Configuration
# Copy this file to .env and update the values

# ========================================
# Application Settings
# ========================================
APP_NAME=VSA-BE-FastAPI
APP_VERSION=2.0.0
DEBUG=false

# ========================================
# Database (PostgreSQL)
# ========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://vsa_user:vsa_password@postgres:5432/vsa_db

POSTGRES_USER=vsa_user
POSTGRES_PASSWORD=vsa_password
POSTGRES_DB=vsa_db

# For local development (without Docker):
# DATABASE_URL=postgresql+asyncpg://vsa_user:vsa_password@localhost:5432/vsa_db

# ========================================
# Redis Cache
# ========================================
# Format: redis://host:port/database_number
REDIS_URL=redis://redis:6379/0

REDIS_PASSWORD=redis_password

# For local development:
# REDIS_URL=redis://localhost:6379/0

# ========================================
# Qdrant Vector Database
# ========================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base

# For local development:
# QDRANT_URL=http://localhost:6333

# ========================================
# LLM Configuration
# ========================================
# API key untuk LLM provider (OpenAI, Anthropic, dll)
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-3.5-turbo

# Alternative models:
# LLM_MODEL=gpt-4
# LLM_MODEL=claude-3-sonnet-20240229

# ========================================
# Speech-to-Text (STT)
# ========================================
# API key untuk STT service (OpenAI Whisper, Google, dll)
STT_API_KEY=your-stt-api-key-here

# ========================================
# CORS Settings
# ========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=["*"]

# For production, specify exact origins:
# CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]

