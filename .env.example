# Copy to .env (git-ignored) and fill in. src/config.py reads .env through the
# /app bind mount; docker-compose.yml deliberately carries none of these.

DEEPGRAM_API_KEY=
EXA_API_KEY=
# Comma-separated, in failover order: the next key takes over when Cartesia
# reports the current one out of credits.
CARTESIA_API_KEY=

# Required by every /api/v1 route and the turn socket when set. The kiosk
# presents the same value: export LUNA_API_TOKEN before starting luna-edge.
# Leave empty only while nothing but this machine can reach port 8000.
API_ACCESS_TOKEN=
