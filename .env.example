# ===== Application =====
APP_NAME=VSA-BE-FastAPI-v2
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== Database =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vsa_db
POSTGRES_USER=bengkod
POSTGRES_PASSWORD=vsa_kece
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
KNOWLEDGE_COLLECTION_NAME=knowledge_collection
FACE_COLLECTION_NAME=faces_collection

# ===== MinIO =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vsa-files
MINIO_SECURE=false

# ===== Ollama =====
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_TEMPERATURE=0.4
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=1024

# ===== GPU (-1 CPU, 0+ GPU) =====
GPU_DEVICE=-1

# ===== Face Recognition (InsightFace) =====
ENABLE_FACE_RECOGNITION=true
FACE_RECOGNITION_MODEL=buffalo_sc
FACE_RECOGNITION_CTX_ID=-1
FACE_DETECTION_SIZE=320
FACE_SIMILARITY_THRESHOLD=0.5

# ===== Speech / TTS =====
WHISPER_MODEL=large
VOICE_CLONE_DIR=storage/voice

# ===== Optional (RAG paths, emotion, CORS) =====
# PERSIST_DIR=storage/index
# ENABLE_EMOTION_DETECTION=true
# CORS_ORIGINS=*
