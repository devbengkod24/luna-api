# ===== Application Settings =====
APP_NAME=VSA-BE-FastAPI
APP_VERSION=1.0.0
DEBUG=false

# ===== Database Configuration =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vsa_db
POSTGRES_USER=bengkod
POSTGRES_PASSWORD=vsa_kece

# ===== Qdrant Vector Database =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=vsa_docs

# ===== LLM Configuration =====
LLM_MODEL=csalab/sahabatai1:llama3_instruct_Q4_K_M
EMBEDDING_MODEL=

# ===== Vision Configuration =====
# Face Recognition
ENABLE_FACE_RECOGNITION=true
FACE_RECOGNITION_MODEL=buffalo_sc
FACE_RECOGNITION_CTX_ID=-1  # -1 for CPU, 0+ for GPU
FACE_DETECTION_SIZE=320
FACE_SIMILARITY_THRESHOLD=0.5

# Ollama (untuk LangChain agent)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# ===== CORS Settings =====
CORS_ORIGINS=["*"]


# For production, specify exact origins:
# CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]